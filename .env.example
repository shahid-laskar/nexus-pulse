# ─────────────────────────────────────────────────────────────────────────────
# BSNL WiFi Admin Portal — environment variables
# Copy to `.env` (or `.env.local`) and adjust. Only variables prefixed with
# VITE_ are exposed to the browser bundle — never put secrets here.
# ─────────────────────────────────────────────────────────────────────────────

# --- API ---------------------------------------------------------------------
# Base URL for the admin API. Leave EMPTY in development to use the Vite proxy
# (/api -> http://localhost:8000). Set to an absolute URL when the frontend is
# served from a different origin than the backend.
VITE_API_BASE_URL=

# Request timeout in milliseconds for all axios calls.
VITE_API_TIMEOUT=30000

# --- Application identity ----------------------------------------------------
VITE_APP_NAME="BSNL Pulse"
VITE_APP_ENV=development           # development | staging | production
VITE_APP_VERSION=0.1.0
# Shown in the top bar so operators always know which environment they act on.
VITE_ENV_BANNER_LABEL=

# --- Realtime / telemetry ----------------------------------------------------
# WebSocket endpoint used for live sessions, alarms and provisioning progress.
# Leave empty to fall back to polling.
VITE_WS_URL=
# Polling interval (ms) for live NOC surfaces when WS is unavailable.
VITE_LIVE_POLL_INTERVAL=15000

# --- Maps / geo (hotspot coverage map) ---------------------------------------
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION="© OpenStreetMap contributors"
VITE_MAP_DEFAULT_CENTER=20.5937,78.9629
VITE_MAP_DEFAULT_ZOOM=5

# --- Captive portal / PM-WANI ------------------------------------------------
# Public captive portal origin used for live preview + QR/voucher deep links.
VITE_CAPTIVE_PORTAL_URL=http://localhost:8080
# PM-WANI central registry reference shown on the compliance screens.
VITE_PMWANI_APP_PROVIDER_ID=
VITE_PMWANI_REGISTRY_URL=https://pmwani.gov.in

# --- Feature flags -----------------------------------------------------------
VITE_FEATURE_MULTI_TENANT=true     # reseller / tenant workspace switching
VITE_FEATURE_VOUCHERS=true         # voucher & guest-code management
VITE_FEATURE_BILLING=true          # plans, invoices, revenue reporting
VITE_FEATURE_PORTAL_STUDIO=true    # captive portal branding studio
VITE_FEATURE_DARK_MODE=true

# --- Observability (optional) ------------------------------------------------
VITE_SENTRY_DSN=
VITE_ANALYTICS_WRITE_KEY=
